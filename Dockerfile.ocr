FROM python:3.12-slim
WORKDIR /srv
# rapidocr pulls full opencv-python, which needs libxcb/libgl at runtime on
# slim images (the crashloop: libxcb.so.1 not found). Force the headless build.
RUN pip install --no-cache-dir fastapi uvicorn pillow rapidocr-onnxruntime==1.4.4 && \
    pip uninstall -y opencv-python && \
    pip install --no-cache-dir opencv-python-headless
COPY ocr_server.py .
ENV PORT=8000
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD python -c "import urllib.request;urllib.request.urlopen('http://localhost:8000/healthz',timeout=3)"
CMD ["sh", "-c", "uvicorn ocr_server:app --host 0.0.0.0 --port ${PORT}"]
