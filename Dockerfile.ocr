FROM python:3.12-slim
WORKDIR /srv
RUN pip install --no-cache-dir rapidocr-onnxruntime==1.4.4 fastapi uvicorn pillow
COPY ocr_server.py .
ENV PORT=8000
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD python -c "import urllib.request;urllib.request.urlopen('http://localhost:8000/healthz',timeout=3)"
CMD ["sh", "-c", "uvicorn ocr_server:app --host 0.0.0.0 --port ${PORT}"]
