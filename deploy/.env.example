# Mamahuhu configuration — copy to .env and edit.
# All vars except the API key are optional; defaults are sane.

# --- Required: OpenAI-compatible gateway (or api.openai.com) ---
# Base URL of the LLM gateway, e.g. https://api.openai.com/v1 or a LiteLLM proxy.
OPENAI_API_BASE=https://api.openai.com/v1
# API key for the gateway. REQUIRED — blank breaks chat/vision/TTS.
OPENAI_API_KEY=

# --- Models (optional — "default" lets the gateway pick) ---
# Chat/translate model name as your gateway knows it.
MODEL_CHAT=default
# Vision (OCR image preprocessing) model.
MODEL_VISION=default
# Speech-to-text model; empty = browser STT fallback.
MODEL_STT=
# Text-to-speech model; empty = browser TTS fallback.
MODEL_TTS=
# Voice for server TTS (kokoro voices, e.g. zf_xiaoxiao female / zm_yunxi male).
TTS_VOICE=
# Optional extras (see deploy/helm-values.yaml for the full palette):
# MODEL_CHAT_FALLBACK=     # retry chat on this model if the primary fails
# MODEL_TTS_CA=            # Cantonese TTS model (e.g. "edge")
# TTS_VOICE_CA=            #   zh-HK-HiuMaanNeural
# TTS_MODE=                # auto | server | browser

# --- Auth ---
# Leave ALL THREE unset for a single-user, no-login setup: every visitor is
# silently logged in as DEV_USER (default "dad"). Fine for localhost/Tailscale;
# DO NOT expose publicly like this.
# Set the three below only behind a forward-auth proxy (Authelia/Authentik/
# traefik) that injects the header — then the proxy owns login:
# TRUST_PROXY_HEADERS=1
# AUTH_HEADER=x-authentik-username     # authelia: remote-user / traefik: x-forwarded-user
# AUTH_NAME_HEADER=x-authentik-name
# DEV_USER=                            # username in no-proxy single-user mode (default "dad")

# --- OCR sidecar — leave as-is (compose prewires them) ---
# OCR_LADDER=1
# OCR_FUSION=1
# OCR_PIPELINE=2
# OCR_DET_URL=http://mamahuhu-ocr:8000/det
# OCR_HTTP_URL=http://mamahuhu-ocr:8000

# --- Set by the image/compose — no need to change ---
# PORT=8787
# DATA_DIR=/data
