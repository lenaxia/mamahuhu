{"lines":[{"n":1,"text":"亲近自然","dir":"h"},{"n":2,"text":"定期举办 野营 活动，让孩子们在帐篷","dir":"h"},{"n":3,"text":"和篝火中学习户外技能，增强独立与","dir":"h"},{"n":4,"text":"合作能力。","dir":"h"},{"n":5,"text":"探索发现","dir":"h"},{"n":6,"text":"带领孩子 采蘑菇、赶海，在自然课","dir":"h"},{"n":7,"text":"堂里认识动植物，学习生态知识，","dir":"h"},{"n":8,"text":"培养观察力与好奇心。","dir":"h"},{"n":9,"text":"健康成长","dir":"h"},{"n":10,"text":"通过 趣味运动会 等活动，提升孩子们的体能","dir":"h"},{"n":11,"text":"和团队精神，在运动中感受快乐与自信。","dir":"h"},{"n":12,"text":"倡导环保 财商培养","dir":"h"},{"n":13,"text":"长期举办 Kids Flea Market，培养孩","dir":"h"},{"n":14,"text":"子的环保意识，倡导资源循环利用。","dir":"h"},{"n":15,"text":"通过趣味交易体验，锻炼孩子的语言","dir":"h"},{"n":16,"text":"表达、社交能力和财商意识。","dir":"h"}]}
